# 도메인 설정
DOMAIN=review.example.com
CERT_EMAIL=your-email@example.com

# API 키 설정
# Anthropic 직접 사용 시: sk-ant-... 키 입력, 아래 BASE_URL과 MODEL 주석 처리
# z.ai 게이트웨이 사용 시: z.ai 키 입력
ANTHROPIC_API_KEY=your-api-key-here

# z.ai 게이트웨이 사용 시 아래 두 값을 설정하세요
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# AI_MODEL=glm-5

# 서버 인증
REVIEW_SECRET=

# GitHub Owner 화이트리스트 (비워두면 전체 허용)
ALLOWED_GITHUB_OWNERS=
GRAFANA_ADMIN_PASSWORD=
