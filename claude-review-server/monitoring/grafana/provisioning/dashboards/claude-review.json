        { "expr": "increase(github_api_errors_total{application=\"claude-review-server\"}[5m])", "legendFormat": "github errors", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] }
    },
    {
      "title": "Error Log Rate",
