      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "jvm_memory_used_bytes{application=\"claude-review-server\", area=\"heap\"}", "legendFormat": "used", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "jvm_memory_max_bytes{application=\"claude-review-server\", area=\"heap\"}", "legendFormat": "max", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "title": "System CPU / Process CPU",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "system_cpu_usage{application=\"claude-review-server\"}", "legendFormat": "system", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "process_cpu_usage{application=\"claude-review-server\"}", "legendFormat": "process", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] }
    },

    {
      "title": "Rate Limit Blocked",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "increase(rate_limit_blocked_total{application=\"claude-review-server\"}[5m])", "legendFormat": "blocked", "datasource": { "type": "prometheus", "uid": "prometheus" } }
